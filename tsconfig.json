{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "dom",
      "dom.iterable",
      "es5",
      "es2020"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".build/types/**/*.ts",
    ".next/885fea825/types/**/*.ts",
    ".next/e21c4bdfc/types/**/*.ts",
    ".next/5062fae85/types/**/*.ts",
    ".next/d8bd1aa57/types/**/*.ts",
    ".next/582c404fb/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".build"
  ]
}
